# @x402api/sdk SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: X402API_
#
# Security environment variables:
X402API_TENANT_API_KEY=your_tenantapikey_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
X402API_DEBUG=true
